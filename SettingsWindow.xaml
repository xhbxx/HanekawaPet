<Window x:Class="HanekawaPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌宠设置" Width="580" Height="710" MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="7,5"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Padding" Value="14"/><Setter Property="Background" Value="White"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="桌上的小伙伴" FontSize="25" FontWeight="SemiBold" Foreground="#172B4D"/>
            <TextBlock x:Name="PackNameText" Margin="0,5,0,18" Foreground="#52627A"/>
            <Button Content="AI 接口与知识库设置…" Click="OnChat" HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <GroupBox Header="日常活动">
                <StackPanel>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                        <TextBlock Text="大小" VerticalAlignment="Center"/>
                        <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="0.5" Maximum="2.5" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="OnScaleChanged"/>
                        <TextBlock x:Name="ScaleText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                        <TextBlock Text="散步速度" VerticalAlignment="Center"/>
                        <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="5" Maximum="160" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSpeedChanged"/>
                        <TextBlock x:Name="SpeedText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <DockPanel Margin="0,0,0,16"><TextBlock Text="活动方式" Width="85" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MovementBox" SelectionChanged="OnMovementChanged" Padding="6">
                            <ComboBoxItem Content="待在原地" Tag="Stay"/><ComboBoxItem Content="持续散步" Tag="Walk"/><ComboBoxItem Content="自由活动（走走停停）" Tag="Wander"/>
                        </ComboBox>
                    </DockPanel>
                    <WrapPanel><CheckBox x:Name="TopmostBox" Content="保持置顶" Checked="OnFlagsChanged" Unchecked="OnFlagsChanged" Margin="0,0,20,12"/>
                        <CheckBox x:Name="SleepBox" Content="手动休息" Checked="OnFlagsChanged" Unchecked="OnFlagsChanged"/></WrapPanel>
                    <TextBlock Text="自动作息：00:00–06:00、13:00–14:00 休息；每闲置 15–25 分钟打哈欠，超过 3 小时休息。清醒空闲时每隔 3–7 分钟随机敲击屏幕。互动后重新计时，休息时段暂醒 1 分钟。" Foreground="#52627A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <CheckBox x:Name="ClickThroughBox" Content="鼠标穿透（可从右下角托盘恢复）" Checked="OnFlagsChanged" Unchecked="OnFlagsChanged"/>
                    <WrapPanel><Button Content="挥手" Click="OnWave"/><Button Content="跳一下" Click="OnJump"/><Button Content="移回当前屏幕" Click="OnResetPosition"/></WrapPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="动画资源">
                <StackPanel>
                    <TextBlock Text="可以先用占位素材，之后按动作替换动画。" Foreground="#52627A" Margin="0,0,0,10"/>
                    <TextBox x:Name="PackPathText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"/>
                    <WrapPanel><Button Content="选择资源包…" Click="OnChoosePack"/><Button Content="打开文件夹" Click="OnOpenFolder"/><Button Content="重新加载" Click="OnReload"/></WrapPanel>
                    <DockPanel Margin="0,5,0,10"><TextBlock Text="选择动作" Width="85" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ActionBox" Padding="6" SelectionChanged="OnActionChanged"/>
                    </DockPanel>
                    <TextBlock x:Name="ActionInfoText" Foreground="#52627A" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,0,0,10"><TextBlock Text="PNG 每帧时长" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="DurationText" Width="65" Text="180" HorizontalAlignment="Left"/>
                        <TextBlock Text="毫秒（GIF 使用文件内的时长）" Foreground="#52627A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>
                    <TextBlock x:Name="PendingText" Foreground="#8A4B13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel><Button Content="预览所选动作" Click="OnPreview"/><Button x:Name="ImportButton" Content="替换所选动作…" Click="OnImport"/></WrapPanel>
                    <TextBlock Text="支持透明 PNG 序列帧、GIF，以及资源包内的精灵图。替换后自动刷新，原有资源会保留。" TextWrapping="Wrap" Foreground="#52627A" FontSize="12"/>
                    <Button Content="使用内置占位资源" Click="OnDefaultPack" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </GroupBox>
            <TextBlock x:Name="StatusText" Foreground="#52627A" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <DockPanel><TextBlock Text="设置自动保存。头顶摸头、脸部戳脸、身体聊天，按住拖动。" FontSize="12" Foreground="#52627A" VerticalAlignment="Center"/>
                <Button Content="关闭" Click="OnClose" HorizontalAlignment="Right" Margin="10,0,0,0"/></DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
