<Window x:Class="HanekawaPet.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="羽川翼桌宠"
        Width="200" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" AllowDrop="True"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove"
        MouseLeftButtonUp="OnMouseUp" MouseRightButtonUp="OnRightClick"
        Loaded="OnLoaded" Closing="OnClosing" SourceInitialized="OnSourceInitialized"
        LostMouseCapture="OnLostCapture" Drop="OnDrop" DragOver="OnDragOver">
    <Grid Background="Transparent">
        <Image x:Name="PetImage" Stretch="Uniform" SnapsToDevicePixels="True"
               RenderTransformOrigin="0.5,0.5" />
    </Grid>
</Window>
