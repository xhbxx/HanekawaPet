<Window x:Class="HanekawaPet.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小翼 · 对话" Width="700" Height="720" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <Button Content="AI 接口与知识库" Click="OnSettings" DockPanel.Dock="Right"/>
            <TextBlock Text="和小翼聊一会儿" FontSize="23" FontWeight="SemiBold" Foreground="#233A59" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <Button x:Name="NewButton" Content="新对话" Click="OnNew" DockPanel.Dock="Right" IsEnabled="False"/>
            <ComboBox x:Name="HistoryBox" DisplayMemberPath="Title" Padding="7" SelectionChanged="OnHistoryChanged" IsEnabled="False"/>
        </DockPanel>
        <Border Grid.Row="2" CornerRadius="12" BorderBrush="#E0E7F0" BorderThickness="1" Background="White" Padding="14">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MessagesPanel"/>
            </ScrollViewer>
        </Border>
        <TextBox x:Name="InputBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" Padding="10" MinHeight="76" MaxHeight="150"
                 VerticalScrollBarVisibility="Auto" MaxLength="8000" PreviewKeyDown="OnInputKey" Margin="0,12,0,10"/>
        <DockPanel Grid.Row="4">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="StopButton" Content="停止" Click="OnStop" IsEnabled="False"/>
                <Button x:Name="SendButton" Content="发送" Click="OnSend" IsEnabled="False"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="正在连接本地服务…" Foreground="#52647E" FontSize="12"/>
                <TextBlock Text="Enter 发送 · Shift+Enter 换行" Foreground="#7B8BA1" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
