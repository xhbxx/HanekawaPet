<Window x:Class="HanekawaPet.SpeechBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="260" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" PreviewKeyDown="OnWindowKey">
    <Border Background="White" BorderBrush="#BBCADD" BorderThickness="1" CornerRadius="6" Padding="8,6">
        <TextBox x:Name="InputBox" MinHeight="24" MaxHeight="80" MaxLength="8000" AcceptsReturn="True"
                 TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                 VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnInputKey"/>
    </Border>
</Window>
